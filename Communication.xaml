<UserControl x:Class="AB_EIP.View.Communication"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AB_EIP.View"
             xmlns:vm="clr-namespace:AB_EIP.MainViewModel"
             xmlns:bh="clr-namespace:GridBehaviorLibrary;assembly=GridBehaviorLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="630">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StatusBarResource.xaml"/>                <!-- Merging the StatusBarResource.xaml into UserControl resources -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:CommViewModel/>        <!--Setting Data Context-->
    </UserControl.DataContext>


    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>            <!--Label Row-->
            <RowDefinition Height="Auto"/>            <!--Action Row-->
            <RowDefinition Height="*"/>               <!--Data Grid-->
            <RowDefinition Height="Auto"/>            <!--Button Row-->
            <RowDefinition Height="Auto"/>            <!--Status Bar-->
        </Grid.RowDefinitions>

        <!--Label Row-->
        <Label Name="LblComm" Grid.Row="0" Content="AB EIP Communication" HorizontalAlignment="Center"
               FontWeight="Bold" FontFamily="Segou UI" FontSize="14"/>

        <!-- Action Row with buttons for start/stop outstation-->
        <GroupBox Grid.Row="1" Header="Action" BorderBrush="Gray" BorderThickness="0.5">
            <Grid Margin="2">
                <Button Content="Start" Width="70" Height="25" HorizontalAlignment="Left" Margin="0,0,0,0" Command="{Binding StartCommand}" Style="{StaticResource Win11ButtonStyle}" ToolTip="Click to start the DNP Server."/>
                <Button Content="Stop" Width="70" Height="25" HorizontalAlignment="Left" Margin="90,0,0,0" Command="{Binding StopCommand}" Style="{StaticResource Win11ButtonStyle}" ToolTip="Click to stop the DNP Server."/>
                <Button Content="Update" Width="70" Height="25" HorizontalAlignment="Right"  Margin="0,0,0,0" Command="{Binding UpdateCommand}" Style="{StaticResource Win11ButtonStyle}" ToolTip="Click to send the updated values of entire table to the DNP client"/>
            </Grid>
        </GroupBox>

        <!-- DataGrid for displaying data -->
        <DataGrid x:Name="CommGrid" Grid.Row="2" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ObjectList}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  bh:EnterKeyGridUpdate.EnterUpdates="True"
                  bh:EnterKeyGridUpdate.EnterKeyCommand="{Binding UpdateRowCommand}"
                  bh:EnterKeyGridUpdate.ApplyToColumn="Value">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Sr.No" Width="Auto" Binding="{Binding SerialNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="PointName" Width="250" Binding="{Binding PointName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Commands" Width="100" Binding="{Binding Commands}" IsReadOnly="True"/>
                <DataGridTextColumn Header="DataType" Width="100" Binding="{Binding DataType}" IsReadOnly="True"/>
                <DataGridTextColumn Header="FileType" Width="100" Binding="{Binding FileType}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Element" Width="Auto" Binding="{Binding ElementNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="File" Width="50" Binding="{Binding File}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Bit" Width="50" Binding="{Binding Bit}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Value" Width="50" Binding="{Binding Value, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Time" Width="70" Binding="{Binding DateTime, StringFormat={}{0:HH:mm:ss}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!--Button Row-->
        <GroupBox Grid.Row="3" Margin="0,0,0,4" BorderBrush="Gray" BorderThickness="0.5">
            <Grid Margin="0,0,0,0">
                <Button Name="BtnHelp" Content="Help" Style="{StaticResource HelpButtonStyle}"
                        HorizontalAlignment="Left" Width="70" Height="25" Margin="0,3,0,0" 
                        ToolTip="Click to open the user-manual."
                        CommandParameter="Protocol_Simulator_UserManual_v1.0.0_07062024.pdf|58"/>                <!--Open UserManual content related to this page.-->
                <Button Name="BtnClearAll" Content="Clear All" Style="{StaticResource Win11ButtonStyle}"
                        HorizontalAlignment="Right" Width="70" Height="25" Margin="10,3,0,0"
                        Command="{Binding ClearCommand}" ToolTip="Click to remove all rows from the table."/>
            </Grid>
        </GroupBox>

        <!--Status Bar-->
        <StatusBar Template="{StaticResource StatusBarTemplate}" Grid.Row="4"/>
    </Grid>

</UserControl>
