<UserControl x:Class="AB_EIP.View.Automation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AB_EIP.View"
             xmlns:vm="clr-namespace:AB_EIP.MainViewModel"
             xmlns:bh="clr-namespace:GridBehaviorLibrary;assembly=GridBehaviorLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StatusBarResource.xaml"/>                <!-- Merge the StatusBarResource.xaml into your UserControl resources -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:AutomateViewModel/>
        <!--Setting DataContext-->
    </UserControl.DataContext>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>            <!--Label Row-->
            <RowDefinition Height="Auto"/>            <!--Action Row-->
            <RowDefinition Height="*"/>               <!--Data Grid-->
            <RowDefinition Height="Auto"/>            <!--Button Row-->
            <RowDefinition Height="Auto"/>            <!--Status Bar-->
        </Grid.RowDefinitions>

        <!--Label-->
        <Label Name="LblObj" Grid.Row="0" Content="Automation" HorizontalAlignment="Center"
               FontWeight="Bold" FontFamily="Segou UI" FontSize="14"/>

        <!-- Action Row with buttons for start/stop server-->
        <GroupBox Grid.Row="1" Header="Action" BorderBrush="Gray" BorderThickness="0.5">
            <Grid Margin="2">
                <Button Content="Auto" Width="70" Height="25" HorizontalAlignment="Left" Margin="0,0,0,0" Command="{Binding AutomateCommand}" Style="{StaticResource Win11ButtonStyle}" ToolTip="Click to run in Auto mode."/>
                <Button Content="Manual" Width="70" Height="25" HorizontalAlignment="Left" Margin="90,0,0,0" Command="{Binding StopAutomateCommand}" Style="{StaticResource Win11ButtonStyle}" ToolTip="Click to run in Manual mode."/>
            </Grid>
        </GroupBox>

        <!-- DataGrid for displaying data -->
        <DataGrid x:Name="AutoGrid" Grid.Row="2" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ObjectList}"
                  bh:EnterKeyGridUpdate.EnterUpdates="True"
                  bh:EnterKeyGridUpdate.EnterKeyCommand="{Binding UpdateRowCommand}"
                  bh:EnterKeyGridUpdate.ApplyToColumn="Value">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sr.No" Width="Auto" Binding="{Binding SerialNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="PointName" Width="250" Binding="{Binding PointName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Command" Width="140" Binding="{Binding Commands}" IsReadOnly="True"/>
                <DataGridTextColumn Header="DataType" Width="60" Binding="{Binding DataType}" IsReadOnly="True"/>
                <DataGridTextColumn Header="FileType" Width="60" Binding="{Binding FileType}" IsReadOnly="True"/>
                <DataGridTextColumn Header="File" Width="60" Binding="{Binding File}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Element" Width="60" Binding="{Binding ElementNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Bit" Width="50" Binding="{Binding Bit}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Value" Width="50" Binding="{Binding Value, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Time" Width="70" Binding="{Binding DateTime, StringFormat={}{0:HH:mm:ss}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Start Point" Width="70" Binding="{Binding Start, Mode=TwoWay}"/>
                <DataGridTextColumn Header="End Point" Width="70" Binding="{Binding End, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Step" Width="50" Binding="{Binding Step, Mode=TwoWay}"/>
                <DataGridComboBoxColumn Header="Output Type" Width="120" SelectedItemBinding="{Binding OutputType, Mode=TwoWay}">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.OutputType, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.OutputType, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridComboBoxColumn Header="Frequency" Width="*" SelectedItemBinding="{Binding Frequency, Mode=TwoWay}">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.Frequency, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.Frequency, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--Button Row-->
        <GroupBox Grid.Row="3" Margin="0,0,0,4" BorderBrush="Gray" BorderThickness="0.5">
            <Grid Margin="0,0,0,0">
                <Button Name="BtnHelp" Content="Help" Style="{StaticResource HelpButtonStyle}"
                        HorizontalAlignment="Left" Width="70" Height="25" Margin="0,3,0,0" 
                        ToolTip="Click to open the user-manual."
                        CommandParameter="Protocol_Simulator_UserManual_v1.0.0_07062024.pdf|88"/>
                <!--Open UserManual content related to this page.-->
                <Button Name="BtnClearAll" Content="Clear All" Style="{StaticResource Win11ButtonStyle}"
                        HorizontalAlignment="Right" Width="70" Height="25" Margin="10,3,0,0"
                        Command="{Binding ClearCommand}" ToolTip="Click to remove all rows from the table."/>
            </Grid>
        </GroupBox>

        <!--Status Bar-->
        <StatusBar Template="{StaticResource StatusBarTemplate}" Grid.Row="4"/>
    </Grid>
</UserControl>
